{
  "name": "wasm-pack-action",
  "version": "0.6.0",
  "private": true,
  "description": "wasm-pack action to install wasm-pack by downloading the executable",
  "type": "module",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "oxfmt --write **/*.ts",
    "format-check": "oxfmt --check **/*.ts",
    "lint": "oxlint src",
    "pack": "esbuild ./src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "all": "npm run build && npm run format && npm run lint & npm run pack && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qmaru/wasm-pack-action.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "wasm-pack"
  ],
  "author": "Jet Li",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "esbuild": "^0.27.2",
    "jest": "^30.4.2",
    "jest-circus": "^30.4.2",
    "js-yaml": "^5.2.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.2"
  }
}
